{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "YouTubeSource Test",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/mediakit/playground.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": true,
            "env": {
